{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "${mod_homepage}",
    "sources": "${mod_sources}"
  },
  "icon": "assets/ravensmodels/icon.png",
  "environment": "${mod_environment}",
  "entrypoints": {
    "main": [
      "io.github.recrivenvi.ravensmodels.RavensModels"
    ],
    "client": [
      "io.github.recrivenvi.ravensmodels.client.RavensModelsClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${mc_version}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  }
}
