{
  "schemaVersion": 1,
  "id": "ravensmod",
  "version": "${version}",
  "name": "Raven's Mod",
  "description": "A mod programmed by RavenYin, specially made for RadianceMod",
  "authors": [
    "RavenYin"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/ravensmod/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.recrivenvi.ravensmod.RavensMod"
    ],
    "client": [
      "com.recrivenvi.ravensmod.client.RavensModClient"
    ]
  },
  "mixins": [
    "ravensmod.mixins.json",
    {
      "config": "ravensmod.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.1.2",
    "java": ">=21",
    "fabric-api": "*",
    "geckolib": "*"
  }
}